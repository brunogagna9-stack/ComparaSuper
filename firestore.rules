rules_version = '2';
// SuperBarato: cada persona solo puede leer, cambiar o borrar SU documento (usuarios/{su id}).
// Los correos los manda un proceso del servidor (scripts/enviar_avisos.py), que no pasa por estas reglas.
// Se publican solas desde GitHub (workflow "Reglas de Firestore") cuando cambia este archivo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      function esDuenio() { return request.auth != null && request.auth.uid == uid; }
      function valido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'semanal', 'bajas', 'promos', 'medios', 'zona', 'acepto', 'avisos', 'actualizado', 'enviados', 'ultimoEnvio', 'ultimoPromos', 'bajaToken', 'bajaUsado'])
          && (!('semanal' in d) || d.semanal is bool)
          && (!('bajas' in d) || d.bajas is bool)
          && (!('promos' in d) || d.promos is bool)
          && (!('medios' in d) || (d.medios is list && d.medios.size() <= 80))
          && (!('zona' in d) || (d.zona is string && d.zona.size() <= 10))
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('avisos' in d) || (d.avisos is map && d.avisos.size() <= 300))
          && (!('acepto' in d) || d.acepto is timestamp)
          && (!('actualizado' in d) || d.actualizado is timestamp);
      }
      // campos que maneja solo el servidor de correos (scripts/enviar_avisos.py): la persona no los puede escribir
      function sinCamposDelServidor() {
        let srv = ['enviados', 'ultimoEnvio', 'ultimoPromos', 'bajaToken', 'bajaUsado'];
        return request.method == 'create'
          ? !request.resource.data.keys().hasAny(srv)
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny(srv);
      }
      allow read, delete: if esDuenio();
      allow create, update: if esDuenio() && valido() && sinCamposDelServidor();
      // Baja con un clic desde el correo, sin iniciar sesión: solo se puede APAGAR "semanal", "bajas" o "promos",
      // y solo con la clave secreta de esa persona (bajaToken) que viaja en el enlace del correo.
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['semanal', 'bajas', 'promos', 'bajaUsado'])
        && resource.data.get('bajaToken', '') is string && resource.data.get('bajaToken', '').size() >= 16
        && request.resource.data.get('bajaUsado', '') == resource.data.get('bajaToken', '')
        && (request.resource.data.get('semanal', false) == false || request.resource.data.get('semanal', false) == resource.data.get('semanal', false))
        && (request.resource.data.get('bajas', false) == false || request.resource.data.get('bajas', false) == resource.data.get('bajas', false))
        && (request.resource.data.get('promos', false) == false || request.resource.data.get('promos', false) == resource.data.get('promos', false));
    }
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
